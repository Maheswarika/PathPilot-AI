# Production / Remote Backend URL (e.g. Railway public domain: https://<service-name>.up.railway.app)
# Leave empty during local development to use Vite's built-in /api proxy.
VITE_API_BASE_URL=

# Local development proxy target (used by Vite dev server when VITE_API_BASE_URL is unset)
VITE_API_PROXY_TARGET=http://localhost:8081
