SPRING_DATASOURCE_URL=jdbc:mysql://<tidb-host>:4000/<database>?sslMode=VERIFY_IDENTITY
SPRING_DATASOURCE_USERNAME=<tidb-cloud-username>
SPRING_DATASOURCE_PASSWORD=<tidb-cloud-password>
JWT_SECRET=replace_with_a_long_random_secret_key
VITE_API_BASE_URL=https://<your-railway-app>.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app,https://*.railway.app

# Optional: bootstrap admin credential for local dev
BOOTSTRAP_ADMIN_EMAIL=admin@pathpilot.local
